# Copy this file to .env and replace each required placeholder with your own
# credentials. Never commit .env or real API keys/passwords.

# Streamlit admin login (development defaults). In production, set APP_ENV to
# production and provide a unique ADMIN_USERNAME and an ADMIN_PASSWORD of at
# least 16 characters through deployment secrets.
APP_ENV=development
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password

# PostgreSQL connection string used by SQLAlchemy and LangGraph checkpointing.
# Use a PostgreSQL service and keep the real credentials in .env or deployment
# secrets, never in source control.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Active workflow providers: both Gemini and Groq are used by the current graph.
ENABLE_GEMINI=true
ENABLE_GROQ=true
GOOGLE_MODEL=gemini-2.5-flash
# Secret: create an API key in Google AI Studio.
GOOGLE_API_KEY=replace_with_your_google_api_key

GROQ_MODEL=openai/gpt-oss-20b
# Secret: create an API key in the Groq console.
GROQ_API_KEY=replace_with_your_groq_api_key
# Present in settings, but the current ChatGroq client does not use this value.
GROQ_API_URL=https://api.groq.com/openai/v1

# Optional provider adapter; the active graph does not currently use OpenAI.
ENABLE_OPENAI=false
OPENAI_MODEL=gpt-4o
# Secret: only needed if an agent is configured to use OpenAI.
OPENAI_API_KEY=replace_with_your_openai_api_key

# Optional: web search is not currently connected to an agent or graph node.
ENABLE_WEB_SEARCH=false
# Secret: only needed if web search is implemented and enabled.
TAVILY_API_KEY=replace_with_your_tavily_api_key

# Optional: LangSmith tracing is not explicitly wired into workflow execution.
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=customer-feedback-dev
# Secret: only needed if LangSmith tracing is configured for the process.
LANGSMITH_API_KEY=replace_with_your_langsmith_api_key

# SMTP credentials used by the email sender. Use an app password when
# required by your mail provider.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_sender_email@example.com
# Secret: enter the SMTP password/app password for SMTP_USER.
SMTP_PASSWORD=replace_with_your_smtp_password

# Escalation recipients use JSON arrays. Defaults are defined in
# src/app/constants/constant.py and can be overridden here.
SUPPORT_EMAILS=["support1@example.com","support2@example.com"]
MANAGER_EMAILS=["manager1@example.com","manager2@example.com"]

# Maximum Needs Evaluation cycles before the final draft-selection step.
MAX_EMAIL_REVISIONS=3
# Retry count per LLM request and timeout in seconds.
LLM_MAX_RETRIES=3
LLM_REQUEST_TIMEOUT_SECONDS=60

# Legacy setting found in some local .env files. The app always calls
# SMTP STARTTLS and does not read EMAIL_USE_TLS.
# EMAIL_USE_TLS=true
